# IBM Nutrition Agent — Environment Configuration
# Copy this file to .env and fill in your credentials.

# ----- IBM watsonx.ai -----
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Granite model IDs (change region prefix if needed)
GRANITE_LLM_MODEL=ibm/granite-13b-instruct-v2
GRANITE_EMBEDDING_MODEL=ibm/slate-125m-english-rtrvr

# ----- Vector Store -----
CHROMA_PERSIST_DIR=./data/chroma_db

# ----- USDA FoodData Central API (free, optional) -----
# Register at https://fdc.nal.usda.gov/api-guide.html
USDA_API_KEY=DEMO_KEY

# ----- App Settings -----
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info
